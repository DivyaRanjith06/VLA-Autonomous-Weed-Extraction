<mujoco model="mobile panda strawberry field">

    <!--
      M1 scene: project-owned copy of
      external/mujoco_menagerie/franka_emika_panda/scene.xml, changed ONLY to
      include the mobile-base Panda (mobile_panda.xml) instead of the fixed-base
      panda.xml. Beds, plants, lighting, camera and materials are unchanged.

      Asset-path note: mobile_panda.xml sets a global `meshdir` (the Franka mesh
      folder). MuJoCo prepends that `meshdir` to every *relative* mesh path,
      including the ones in the plant stub XMLs, which corrupts them
      (e.g. .../franka_emika_panda/assets/simulation/assets/plants/...). So the
      plant meshes are declared in the <asset> block below with ABSOLUTE file
      paths (absolute paths bypass `meshdir`), and the plant stub XMLs
      (strawberry.xml / sowthistle.xml / shepherd.xml) are NOT included here.
      Those stub files are unchanged on disk; only their one <mesh> each is
      reproduced below, with identical names and scales. This scene then
      compiles whether loaded via a relative or an absolute path.
    -->

    <!-- ========================= -->
    <!-- ROBOT (mobile base + Panda arm) -->
    <!-- ========================= -->

    <include file="mobile_panda.xml"/>


    <!-- ========================= -->
    <!-- PLANT MESH ASSETS -->
    <!-- Declared here (not via the plant stub <include>s) so their file paths -->
    <!-- bypass the Franka `meshdir` inherited from mobile_panda.xml. Names and -->
    <!-- scales are identical to simulation/models/{strawberry,sowthistle,shepherd}.xml -->
    <!-- ========================= -->

    <asset>
        <mesh name="strawberry_mesh"
              file="/home/divya/VLA-Weed-Extraction/simulation/assets/plants/strawberry/strawberry.stl"
              scale="0.18 -0.18 0.18"/>
        <mesh name="sowthistle_mesh"
              file="/home/divya/VLA-Weed-Extraction/simulation/assets/plants/sowthistle/sowthistle.stl"
              scale="0.05 0.05 0.05"/>
        <mesh name="shepherd_mesh"
              file="/home/divya/VLA-Weed-Extraction/simulation/assets/plants/shepherd/shepherd.stl"
              scale="0.40 0.40 0.40"/>
    </asset>


    <!-- ========================= -->
    <!-- VISUAL SETTINGS -->
    <!-- ========================= -->

    <visual>

        <headlight
            diffuse="0.6 0.6 0.6"
            ambient="0.25 0.25 0.25"
            specular="0.1 0.1 0.1"/>

        <rgba
            haze="0.92 0.96 1.0 1"/>

        <global
            azimuth="145"
            elevation="-25"/>

    </visual>


    <!-- ========================= -->
    <!-- ENVIRONMENT ASSETS -->
    <!-- ========================= -->

    <asset>

        <!-- Sky -->
        <texture
            type="skybox"
            builtin="gradient"
            rgb1="0.65 0.82 0.95"
            rgb2="0.95 0.98 1.0"
            width="512"
            height="3072"/>


        <!-- Soil -->
        <texture
            name="soil"
            type="2d"
            file="../assets/ground/sparse_grass_diff_4k.png"/>

        <material
            name="soil"
            texture="soil"
            texuniform="true"
            texrepeat="2 2"
            reflectance="0"
            shininess="0"
            specular="0"/>

    </asset>


    <!-- ========================= -->
    <!-- WORLD -->
    <!-- ========================= -->

    <worldbody>


        <!-- SUN -->
        <light
            name="sun"
            directional="true"
            pos="0 0 5"
            dir="-0.4 -0.3 -1"
            diffuse="1.0 0.98 0.92"
            ambient="0.35 0.35 0.35"
            specular="0.1 0.1 0.1"
            castshadow="true"/>


        <!-- ========================= -->
        <!-- WALKING PATH -->
        <!-- ========================= -->

        <geom
            name="path"
            type="plane"
            pos="0 0 -0.02"
            size="8 8 0.1"
            material="soil"/>


        <!-- ========================= -->
        <!-- RAISED BED 1 -->
        <!-- ========================= -->

        <geom
            name="bed1"
            type="box"
            pos="0.80 -0.50 0.05"
            size="2.5 0.35 0.05"
            material="soil"/>


        <!-- ========================= -->
        <!-- RAISED BED 2 -->
        <!-- ========================= -->

        <geom
            name="bed2"
            type="box"
            pos="0.80 0.50 0.05"
            size="2.5 0.35 0.05"
            material="soil"/>


        <!-- ================================================= -->
        <!-- STRAWBERRIES — BED 1 -->
        <!-- ================================================= -->

        <body name="strawberry_1" pos="-0.80 -0.50 0.10">
            <geom type="mesh" mesh="strawberry_mesh"
                  rgba="0.15 0.55 0.12 1"/>
        </body>

        <body name="strawberry_2" pos="0.00 -0.50 0.10">
            <geom type="mesh" mesh="strawberry_mesh"
                  rgba="0.15 0.55 0.12 1"/>
        </body>

        <body name="strawberry_3" pos="0.80 -0.50 0.10">
            <geom type="mesh" mesh="strawberry_mesh"
                  rgba="0.15 0.55 0.12 1"/>
        </body>

        <body name="strawberry_4" pos="1.60 -0.50 0.10">
            <geom type="mesh" mesh="strawberry_mesh"
                  rgba="0.15 0.55 0.12 1"/>
        </body>


        <!-- ================================================= -->
        <!-- STRAWBERRIES — BED 2 -->
        <!-- ================================================= -->

        <body name="strawberry_5" pos="-0.80 0.50 0.10">
            <geom type="mesh" mesh="strawberry_mesh"
                  rgba="0.15 0.55 0.12 1"/>
        </body>

        <body name="strawberry_6" pos="0.00 0.50 0.10">
            <geom type="mesh" mesh="strawberry_mesh"
                  rgba="0.15 0.55 0.12 1"/>
        </body>

        <body name="strawberry_7" pos="0.80 0.50 0.10">
            <geom type="mesh" mesh="strawberry_mesh"
                  rgba="0.15 0.55 0.12 1"/>
        </body>

        <body name="strawberry_8" pos="1.60 0.50 0.10">
            <geom type="mesh" mesh="strawberry_mesh"
                  rgba="0.15 0.55 0.12 1"/>
        </body>


        <!-- ================================================= -->
        <!-- SOWTHISTLE — BED 1 -->
        <!-- ================================================= -->

        <body name="sowthistle_1" pos="-0.35 -0.50 0.10">
            <geom type="mesh" mesh="sowthistle_mesh"
                  rgba="0.20 0.65 0.12 1"/>
        </body>

        <body name="sowthistle_2" pos="0.45 -0.50 0.10">
            <geom type="mesh" mesh="sowthistle_mesh"
                  rgba="0.20 0.65 0.12 1"/>
        </body>


        <!-- ================================================= -->
        <!-- SOWTHISTLE — BED 2 -->
        <!-- ================================================= -->

        <body name="sowthistle_3" pos="-0.35 0.50 0.10">
            <geom type="mesh" mesh="sowthistle_mesh"
                  rgba="0.20 0.65 0.12 1"/>
        </body>

        <body name="sowthistle_4" pos="1.25 0.50 0.10">
            <geom type="mesh" mesh="sowthistle_mesh"
                  rgba="0.20 0.65 0.12 1"/>
        </body>


        <!-- ================================================= -->
        <!-- SHEPHERD'S PURSE — BED 1 -->
        <!-- ================================================= -->

        <body name="shepherd_1" pos="0.20 -0.50 0.10">
            <geom type="mesh" mesh="shepherd_mesh"
                  rgba="0.25 0.65 0.15 1"/>
        </body>

        <body name="shepherd_2" pos="1.85 -0.50 0.10">
            <geom type="mesh" mesh="shepherd_mesh"
                  rgba="0.25 0.65 0.15 1"/>
        </body>


        <!-- ================================================= -->
        <!-- SHEPHERD'S PURSE — BED 2 -->
        <!-- ================================================= -->

        <body name="shepherd_3" pos="-1.20 0.50 0.10">
            <geom type="mesh" mesh="shepherd_mesh"
                  rgba="0.25 0.65 0.15 1"/>
        </body>

        <body name="shepherd_4" pos="0.55 0.50 0.10">
            <geom type="mesh" mesh="shepherd_mesh"
                  rgba="0.25 0.65 0.15 1"/>
        </body>


        <!-- ========================= -->
        <!-- CAMERA -->
        <!-- ========================= -->

        <camera
            name="rgb_camera"
            mode="track"
            target="link0"
            pos="1.4 -0.8 0.9"/>

    </worldbody>

</mujoco>
