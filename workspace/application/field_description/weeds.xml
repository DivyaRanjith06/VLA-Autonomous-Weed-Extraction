    <default>
        <default class="weed_visual">
            <geom type="mesh" contype="0" conaffinity="0" group="2"/>
        </default>
        <!-- condim=4 adds torsional friction, so a gripped stem cannot spin free. -->
        <default class="weed_collision">
            <geom type="mesh" group="3" condim="4" friction="1.5 0.02 0.001"/>
        </default>
        <!-- Stiff enough to stand up under its own weight, soft enough to be pushed
             aside. The armature is what sets the sway: the segments' own inertia is
             so small that stiffness alone would put the stalk at 27 Hz, which reads
             as a twitch rather than a plant. Added inertia drops that to ~3 Hz, and
             the damping is then a fraction of critical so the stalk swings past
             upright a few times before settling, the way a real stem does.
             The travel limit matters as much: three joints free to turn 69 deg each
             let the plant fold flat and drop its own tip 20 cm, which turns any
             sideways drag into an upward one. 29 deg each keeps it a bend. -->
        <default class="stalk">
            <joint type="hinge" stiffness="0.05" damping="8e-4" armature="1.4e-4"
                   range="-0.5 0.5" limited="true"/>
        </default>
    </default>

